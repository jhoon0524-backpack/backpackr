# =========================================
# systemd 사용자 유닛 (리눅스 자동 실행용 템플릿)
#
# 이 파일은 "템플릿"입니다. 루프를 돌릴 본인 컴퓨터(리눅스)에서
# 아래 두 줄의 경로를 실제 저장소 위치로 고친 뒤 등록하세요.
# 맥이면 launchd, 윈도우면 작업 스케줄러를 대신 씁니다 (README.md 참고).
#
# 등록 방법:
#   mkdir -p ~/.config/systemd/user
#   cp loop/ai-loop.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable ai-loop     # 로그인하면 자동 시작
#   systemctl --user start ai-loop      # 지금 켜기
# =========================================

[Unit]
Description=AI autonomous dev loop

[Service]
Type=simple
# ↓ 본인 컴퓨터의 저장소 경로로 바꾸세요
WorkingDirectory=%h/backpackr
ExecStart=/bin/bash %h/backpackr/loop/loop.sh
# 비정상 종료면 재시작, 정상 종료(STOP/최대 바퀴)면 그대로 둔다
Restart=on-failure
RestartSec=10
# 자동 실행은 평소 터미널 환경(PATH)을 물려받지 않는다.
# claude 실행 파일 위치가 다르면 여기에 추가하세요. (which claude 로 확인)
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/.npm-global/bin

[Install]
WantedBy=default.target

# 이 파일을 .env.local 로 복사해서 값을 채운다. 실제 값은 절대 커밋하지 않는다.
#   cp .env.example .env.local

# --- 데이터베이스 ---
# 앱·마이그레이션·DB 테스트가 직접 붙는 주소. 로컬 Postgres 는 README.md "데이터베이스" 절 참고.
DATABASE_URL=postgresql://commission:commission@127.0.0.1:5432/commission_dev
# scripts/db.mjs setup 이 역할과 DB 를 만들 때 쓰는 관리자 비밀번호 (로컬에서만)
POSTGRES_PASSWORD=
#
# 배포(Vercel)에서는 Supabase 의 Transaction pooler 문자열을 쓴다 (dropbid/.env.example 의 설명과 같다).
#   postgresql://postgres.<project-ref>:<비밀번호>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- 배포에서만 쓰는 것 ---
# 서버리스는 인스턴스마다 풀을 따로 만든다. 상한이 없으면 인스턴스가 늘어난 만큼 연결이 늘어
# 어느 순간 DB 가 새 연결을 거절한다. 안 넣으면 배포 3, 로컬 10.
DB_POOL_MAX=
#
# 시연용 사용자 전환기를 켤지. **배포에서는 안 넣는 것이 기본(잠김)이다.**
# 지금 로그인은 쿠키 하나가 전부라, 켠 채로 공개하면 누구나 남이 될 수 있다.
# 켜려면 Vercel Deployment Protection 으로 주소 자체를 막고 함께 켠다 (DEPLOY.md 0장).
# 켜는 말은 'on' 하나뿐이다. 'true' 나 '1' 로는 안 열린다.
DEMO_LOGIN=

# --- 아직 안 붙인 것 (자리만) ---
# 카카오 로그인은 Supabase Auth 프로바이더 설정으로 처리하므로 여기 키가 필요 없다.
# 결제(포트원)는 SPEC.md 4장 경계 — 이번 단계에서는 붙이지 않는다.

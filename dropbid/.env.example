# 이 파일을 .env.local 로 복사해서 값을 채운다. 실제 값은 절대 커밋하지 않는다.
#   cp .env.example .env.local

# --- Supabase ---
# supabase start 로 띄웠다면 그 출력에 나오는 값. 아니면 프로젝트 설정에서 가져온다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 번들에 절대 들어가면 안 된다 (NEXT_PUBLIC_ 접두사 금지)
SUPABASE_SERVICE_ROLE_KEY=

# --- 데이터베이스 ---
# 마이그레이션과 DB 함수 테스트가 직접 붙는 주소.
# Docker 없이 로컬 Postgres 를 쓸 때는 README.md "데이터베이스" 절 참고
DATABASE_URL=postgresql://dropbid:dropbid@127.0.0.1:5432/dropbid_dev
#
# 배포(Vercel)에서는 Supabase 의 **Transaction pooler** 문자열을 쓴다.
# Supabase 대시보드 → Connect → Direct(Connection string) → Transaction pooler
#   postgresql://postgres.<project-ref>:<비밀번호>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# 고르는 기준: 주소에 pooler.supabase.com 이 있고 포트가 6543 이어야 한다.
#   - db.<ref>.supabase.co:5432  (Direct)        → 서버리스에서 연결이 금방 동난다
#   - ...pooler.supabase.com:5432 (Session)      → 위와 같은 이유로 부적합
#
# 비밀번호에 @ : / ? # 같은 기호가 있으면 주소 형식이 깨진다.
# 퍼센트 인코딩하거나, 영문·숫자로만 다시 정하는 편이 낫다.
#
# 값을 바꾸면 반드시 다시 배포해야 한다. 환경변수는 배포 시점의 값이 박힌다.
# 안 하면 옛 값 그대로 돈다 (실제로 두 번 겪었다).

# --- 카카오 알림톡 ---
# 로그인은 Supabase Auth 의 카카오 프로바이더 설정으로 처리하므로 여기 키가 필요 없다.
# 알림톡은 발신 프로필과 템플릿 사전 승인이 있어야 발송된다 (PRD 의존성)
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=

# --- 포트원 (PG) ---
NEXT_PUBLIC_PORTONE_STORE_ID=
PORTONE_API_SECRET=
# 결제 완료 웹훅 검증용
PORTONE_WEBHOOK_SECRET=

# --- 이메일 폴백 ---
# 알림톡 발송 실패 시 이메일로 재발송한다 (PRD 알림)
SMTP_URL=
